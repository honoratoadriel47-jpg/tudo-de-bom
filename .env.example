# ───────────── TUDO DE BOM — variáveis de ambiente ─────────────
# Copie este arquivo para ".env" e ajuste os valores.

# Porta e ambiente
PORT=3000
NODE_ENV=development            # use "production" no servidor (ativa cookie Secure)

# URL pública do site (usada em links, SEO e mensagens)
PUBLIC_URL=http://localhost:3000

# Banco de dados SQLite (arquivo) e pasta de uploads de imagens
DB_PATH=./data/tudodebom.db
UPLOAD_DIR=./data/uploads

# Administrador criado automaticamente no primeiro start (TROQUE A SENHA!)
ADMIN_EMAIL=admin@tudodebom.com.br
ADMIN_PASSWORD=troque-esta-senha
# Funcionário (opcional) — acesso apenas aos pedidos
STAFF_EMAIL=
STAFF_PASSWORD=

# Duração da sessão do painel, em horas
SESSION_TTL_HOURS=12

# Atrás de proxy (Nginx, Render, Railway...)? Use 1 para ler o IP real em X-Forwarded-For
TRUST_PROXY=0

# ── Integrações opcionais (deixe vazio enquanto não tiver) ──
# Webhook chamado a cada novo pedido / mudança de status (impressora, n8n, Zapier...)
ORDER_WEBHOOK_URL=
# WhatsApp Cloud API (Meta) — envio automático da mensagem para a loja
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_CLOUD_PHONE_ID=
